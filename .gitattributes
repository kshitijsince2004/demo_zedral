# Shell scripts and deploy tooling must use LF (bash on Linux/EC2 breaks on CRLF).
*.sh text eol=lf
deploy/** text eol=lf

# Source/text files — normalize to LF to avoid CRLF phantom diffs on Windows.
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf

# Copy to deploy/.env on the EC2 VM (never commit deploy/.env)
# Generate secrets: openssl rand -hex 32

# ─── HTTP ────────────────────────────────────────────────────────────────────
HTTP_PORT=80

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# DB_USER = bootstrap/superuser (Postgres container init + migrations only)
DB_USER=m1_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=m1_db
# Runtime application role — NOBYPASSRLS (must match migration 1797000000000_app_rls_role)
DB_APP_USER=m1_app
DB_APP_PASSWORD=CHANGE_ME_M1_APP_PASSWORD

# Used by app at runtime (m1_app — RLS enforced)
DATABASE_URL=postgres://m1_app:CHANGE_ME_M1_APP_PASSWORD@db:5432/m1_db
# Optional local/npm migrate override (compose entrypoint uses DB_MIGRATE_* from DB_USER)
MIGRATE_DATABASE_URL=postgres://m1_user:CHANGE_ME_STRONG_PASSWORD@db:5432/m1_db

# ─── Auth (required in production) ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM
AUTH_STRICT=true
VALIDATION_STRICT=true
SUPERTOKENS_CORE_URI=http://supertokens:3567
SUPERTOKENS_API_KEY=CHANGE_ME_STRONG_KEY
API_DOMAIN=https://api.example.com
WEBSITE_DOMAIN=https://example.com
# QA Deploy AWS sets these from AWS_PUBLIC_URL (e.g. https://qa.zedral.com) on each deploy.
# Render demo: copy deploy/.env.render.example → set API/WEBSITE/CORS to https://demo.zedral.com

# Single-tenant pilot — must match seeded tenant UUID in database
TENANT_ID=00000000-0000-0000-0000-000000000001

# Comma-separated allowed browser origins (web + operator APK).
# QA:      CORS_ORIGIN=https://qa.zedral.com
# Render:  CORS_ORIGIN=https://demo.zedral.com  (see deploy/.env.render.example)
# Factory: CORS_ORIGIN=https://hsl.zedral.com,https://localhost,capacitor://localhost
# Required in production — empty list fails startup / deploy preflight.
# If left empty, deploy auto-fills from WEBSITE_DOMAIN when that is set.
CORS_ORIGIN=https://example.com

# Machine-to-machine canon ingestion (/v1/canon)
SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN
# Optional: per-tenant map instead of single token — JSON object tenantId→token
# SERVICE_TOKEN_MAP={"00000000-0000-0000-0000-000000000001":"token-for-tenant-a"}

# ─── Runtime flags ───────────────────────────────────────────────────────────
# Deploy script runs migrations as a discrete step before backend start.
# Leave false here so a raw `compose up` does not double-migrate; set true only
# for manual one-shot boots without remote-ghcr-deploy.sh.
RUN_MIGRATIONS=false
EXPORT_WORKER_ENABLED=true
EXPORT_WORKER_POLL_MS=15000
DPR_SCHEDULER_ENABLED=true
DPR_SCHEDULE_HOUR=7
SHIFT_BOUNDARY_SCHEDULER_ENABLED=false

# ─── GHCR images (set by CI/CD; required — compose is pull-only, never builds) ─
# Tags: <git-sha> | latest-main | v1.3.0
# Example: ghcr.io/<owner>/<repo>/backend:latest-main
BACKEND_IMAGE=
NGINX_IMAGE=
# Optional pgaudit Postgres (build from deploy/postgres/). Default: postgres:15-alpine
# POSTGRES_IMAGE=zedral-postgres:15-pgaudit

# App↔DB SSL (enable only after Postgres SSL is on — SAFE_CHANGE #15)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Encrypted backups — public age recipient (private key stays off-box)
# AGE_RECIPIENT=age1...

# ─── Optional object storage for export artifacts ────────────────────────────
MINIO_ENDPOINT=
MINIO_BUCKET=m1-exports
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1

# ─── Optional Elasticsearch (traceability search) ────────────────────────────
# Leave ELASTICSEARCH_URL empty to use PostgreSQL-only traceability fallback.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

{
  "name": "@m1/client",
  "private": true,
  "version": "1.2.11",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:operator": "vite --config vite.operator.config.ts --mode operator",
    "prebuild": "npm run build -w @m1/shared-validation",
    "build": "vite build",
    "build:operator": "vite build --config vite.operator.config.ts --mode operator",
    "check:operator-bundle": "npm run build:operator && node scripts/check-operator-bundle.mjs",
    "android:sync": "npm run build:operator && npx cap sync android",
    "android:icons": "python android/scripts/generate_launcher_icons.py",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && node scripts/assemble-android-apk.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-mlkit/text-recognition": "^8.2.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@hookform/resolvers": "^5.8.0",
    "@m1/shared-validation": "*",
    "@tanstack/react-virtual": "^3.14.8",
    "idb": "^8.0.3",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "supertokens-auth-react": "^0.51.2",
    "supertokens-web-js": "^0.16.0",
    "swr": "^2.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fast-check": "^3.19.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.0.12",
    "vitest": "^1.6.0"
  }
}

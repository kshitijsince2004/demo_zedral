# ─── Server (@m1/server) ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=5432
DB_USER=m1_user
DB_PASSWORD=m1_password
DB_NAME=m1_db
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DATABASE_URL=postgres://m1_user:m1_password@localhost:5432/m1_db
# Optional override for integration tests (falls back to DATABASE_URL)
TEST_DATABASE_URL=
# Set to false to disable application-level audit writes (defaults off when NODE_ENV=test)
AUDIT_ENABLED=

TENANT_ID=00000000-0000-0000-0000-000000000001

JWT_SECRET=change-me-in-production
AUTH_STRICT=true
VALIDATION_STRICT=true
# Comma-separated origins for cross-origin API (empty = same-origin)
CORS_ORIGIN=
RUN_MIGRATIONS=true

# SuperTokens Auth
SUPERTOKENS_CORE_URI=http://localhost:3567
SUPERTOKENS_API_KEY=local_development_key
API_DOMAIN=http://localhost:3005
WEBSITE_DOMAIN=http://localhost:5173

EXPORT_WORKER_ENABLED=true
EXPORT_WORKER_POLL_MS=5000
EXPORT_SYSTEM_USER_ID=1
DPR_SCHEDULER_ENABLED=true
DPR_SCHEDULE_HOUR=7
SHIFT_BOUNDARY_SCHEDULER_ENABLED=false

# Optional object storage for export artifacts
MINIO_ENDPOINT=
MINIO_BUCKET=m1-exports
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1

# ─── Client (@m1/client) ─────────────────────────────────────────────────────
# Vite dev-only auto login (never enable in production)
VITE_DEV_AUTO_LOGIN=false

# ─── Operator APK (packages/client/.env.operator) ────────────────────────────
# Vite --mode operator loads .env.operator for Capacitor/APK builds.
# Must be your PC/plant LAN IP — NOT localhost. Port must match PORT above.
# VITE_API_URL=http://10.149.217.114:3005

erDiagram
  CANON_EQUIPMENT_NODE ||--o{ OEE_IDEAL_CYCLE : "rated for"
  CANON_EQUIPMENT_NODE ||--o{ OEE_INTERVAL : "measured at"
  CANON_SHIFT ||--o{ OEE_INTERVAL : "defines PPT for"
  CANON_STATE_EVENT ||--o{ OEE_STATE_INTERVAL : "resolved into"
  CANON_DOWNTIME_EVENT ||--o{ OEE_LOSS_ATTRIBUTION : "attributed as"
  CANON_PRODUCTION_COUNT ||--o{ OEE_INTERVAL : "feeds P&Q"
  CANON_REASON_CODE ||--o{ CANON_DOWNTIME_EVENT : "classifies"
  CANON_LOSS_CATEGORY ||--o{ CANON_REASON_CODE : "groups (Six Big Losses)"
  OEE_CONFIG ||--o{ OEE_INTERVAL : "policy for"
  OEE_INTERVAL ||--o{ OEE_LOSS_ATTRIBUTION : "decomposes into"
  OEE_LOSS_ATTRIBUTION ||--o{ OEE_TOP_LOSS : "ranked into"

  OEE_CONFIG {
    uuid tenant_id PK
    int micro_stop_threshold_sec
    text planned_time_convention
    text performance_basis
    bool teep_enabled
  }
  OEE_IDEAL_CYCLE {
    bigint ideal_cycle_id PK
    bigint material_ref FK
    bigint work_unit_ref FK
    numeric ideal_cycle_time_sec
    text source
    int version
  }
  OEE_STATE_INTERVAL {
    bigint state_interval_id PK
    bigint work_unit_ref FK
    text state
    bool is_planned
    text counts_as
    timestamptz start_ts
    timestamptz end_ts
  }
  OEE_INTERVAL {
    bigint oee_interval_id PK
    bigint work_unit_ref FK
    bigint shift_ref FK
    numeric planned_production_time_min
    numeric operating_time_min
    numeric total_count
    numeric good_count
    numeric availability
    numeric performance
    numeric quality
    numeric oee
    numeric teep
  }
  OEE_LOSS_ATTRIBUTION {
    bigint loss_attr_id PK
    bigint oee_interval_ref FK
    bigint loss_category_ref FK
    bigint reason_ref FK
    numeric lost_minutes
    numeric lost_units
    numeric lost_cost
  }
  OEE_TOP_LOSS {
    bigint top_loss_id PK
    bigint scope_ref
    text rank_basis
    int rank
    numeric value
  }

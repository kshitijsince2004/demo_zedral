# Paste into Render env (never commit real secrets).
# Full steps: deploy/RENDER_DEMO.md
# Generate secrets: openssl rand -hex 32

# ═══ Nginx Web Service (public: demo-zedral.onrender.com) ═══════════════════
# Required on Render — Compose default backend:3005 will 502 here.
# Use the API service name + the PORT that service listens on (Render dashboard).
BACKEND_UPSTREAM=zedral-api:10000
# Optional; empty = read nameserver from /etc/resolv.conf
# NGINX_RESOLVER=

# ═══ API Web Service (Docker target: backend) ═══════════════════════════════
NODE_ENV=production

# Render sets PORT automatically — do not hardcode 3005 on Render.

# ─── Postgres (from Render dashboard → Internal / External Database URL) ─────
# Prefer Internal URL when API and DB are in the same Render region.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME
# If the app also needs discrete fields (migrations / entrypoint), set from the same DB:
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_APP_USER=
DB_APP_PASSWORD=
MIGRATE_DATABASE_URL=
RUN_MIGRATIONS=true
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ─── Auth / public URLs ─────────────────────────────────────────────────────
# Must match the browser URL on the nginx service (onrender or custom domain).
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM
AUTH_STRICT=true
VALIDATION_STRICT=true
SUPERTOKENS_CORE_URI=http://CHANGE_ME_ST_SERVICE_NAME:3567
SUPERTOKENS_API_KEY=CHANGE_ME_STRONG_KEY
# While testing on Render subdomain:
API_DOMAIN=https://demo-zedral.onrender.com
WEBSITE_DOMAIN=https://demo-zedral.onrender.com
CORS_ORIGIN=https://demo-zedral.onrender.com
# After Cloudflare custom domain on nginx:
# API_DOMAIN=https://demo.zedral.com
# WEBSITE_DOMAIN=https://demo.zedral.com
# CORS_ORIGIN=https://demo.zedral.com
TENANT_ID=00000000-0000-0000-0000-000000000001
SERVICE_TOKEN=CHANGE_ME_SERVICE_TOKEN

# ─── Demo-light runtime ──────────────────────────────────────────────────────
CACHE_DRIVER=memory
REDIS_URL=
ELASTICSEARCH_URL=
EXPORT_WORKER_ENABLED=true
EXPORT_WORKER_POLL_MS=15000
DPR_SCHEDULER_ENABLED=true
DPR_SCHEDULE_HOUR=7
SHIFT_BOUNDARY_SCHEDULER_ENABLED=false

# ─── Client (baked into nginx image at build; no separate Static Site needed) ─
# VITE_SHOW_SEED_LOGIN=true  (set at image build if you want seed chips on Login)

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@zedral/platform": ["./packages/platform/src"],
      "@zedral/platform/*": ["./packages/platform/src/*"],
      "@zedral/m1-collection": ["./packages/modules/m1-collection/src"],
      "@zedral/m1-collection/*": ["./packages/modules/m1-collection/src/*"],
      "@zedral/connectors": ["./packages/connectors/src"],
      "@zedral/connectors/*": ["./packages/connectors/src/*"],
      "@m1/shared-validation": ["./packages/shared-validation/src"],
      "@m1/shared-validation/*": ["./packages/shared-validation/src/*"]
    }
  }
}

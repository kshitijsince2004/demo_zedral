{
  "name": "m1-digital-data-collection",
  "version": "1.0.0",
  "private": true,
  "description": "M1 Digital Data Collection for Hero Steels Limited",
  "workspaces": [
    "packages/*",
    "packages/modules/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:all": "node scripts/check-dev-ports.mjs && docker compose up -d db-primary && npx --yes concurrently -k -n server,client -c blue,green \"npm run dev -w @m1/server\" \"npm run dev -w @m1/client\"",
    "build": "npm run build -w @m1/shared-validation && npm run build -w @zedral/platform && npm run build -w @zedral/connectors && npm run build -w @zedral/m1-collection && npm run build -w @m1/client && npm run build -w @m1/server",
    "build:operator": "npm run check:operator-bundle -w @m1/client",
    "android:sync": "npm run android:sync -w @m1/client",
    "android:apk": "npm run android:apk -w @m1/client",
    "test": "npm run test --workspaces --if-present",
    "arch:deps": "depcruise --config .dependency-cruiser.cjs packages",
    "arch:test": "npm run test:arch -w @m1/server",
    "arch:check": "npm run arch:deps && npm run arch:test",
    "smoke:pilot": "npm run smoke:pilot -w @m1/server",
    "smoke:api": "npm run smoke:api -w @m1/server",
    "migrate": "npm run migrate -w @m1/server",
    "seed:pilot": "npm run seed:pilot -w @m1/server",
    "seed:profiles": "npm run seed:profiles -w @m1/server",
    "seed:admin": "npm run seed:admin -w @m1/server",
    "lint": "npm run lint --workspaces --if-present",
    "docker:prod": "docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d",
    "e2e:smoke": "npm run test:smoke --prefix e2e"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.0.0",
    "typescript": "^5.5.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.2",
    "@rolldown/binding-linux-x64-musl": "1.0.2",
    "@rolldown/binding-win32-x64-msvc": "1.0.2",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.0",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.0"
  }
}

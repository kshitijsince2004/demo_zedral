flowchart TD
  I["Input 100% (raw issues - returns +/- dRaw), MT"]
  C["- Crop (head/tail)"]
  S["- Scale / oxidation"]
  T["- Side trim / edge"]
  TR["- Transition / grade-change"]
  CB["- Cobble / process upset"]
  OG["- Off-gauge / dimensional"]
  RW["- Rework loss (net of recovery)"]
  SM["- Sampling / test"]
  G["Good / Prime output, MT"]
  GAP["Unreconciled gap"]
  RTY["x across steps -> Rolled Throughput Yield"]
  I --> C --> S --> T --> TR --> CB --> OG --> RW --> SM --> G
  G --> RTY
  I -. "if Input - accounted Output > +/-1-2% tolerance" .-> GAP
  GAP -. "DATA DEVIATION, not yield loss -> metrology/logging fix" .-> FIX["Data-quality (Principle 4)"]
  classDef in fill:#ede9fe,stroke:#7c3aed;
  classDef loss fill:#fee2e2,stroke:#dc2626;
  classDef good fill:#dcfce7,stroke:#16a34a;
  classDef gap fill:#fef9c3,stroke:#ca8a04;
  class I in;
  class C,S,T,TR,CB,OG,RW,SM loss;
  class G good;
  class GAP gap;

# ─── Server (@m1/server) ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=5432
DB_USER=m1_user
DB_PASSWORD=m1_password
DB_NAME=m1_db
# Runtime RLS role (NOBYPASSRLS) — app connects as this via DATABASE_URL
DB_APP_USER=m1_app
DB_APP_PASSWORD=m1_app_password
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DATABASE_URL=postgres://m1_app:m1_app_password@localhost:5432/m1_db
# Bootstrap/superuser for migrations (npm run migrate prefers this over DATABASE_URL)
MIGRATE_DATABASE_URL=postgres://m1_user:m1_password@localhost:5432/m1_db
# Optional override for integration tests (falls back to DATABASE_URL)
TEST_DATABASE_URL=
# Set to false to disable application-level audit writes (defaults off when NODE_ENV=test)
AUDIT_ENABLED=

TENANT_ID=00000000-0000-0000-0000-000000000001

JWT_SECRET=change-me-in-production
AUTH_STRICT=true
VALIDATION_STRICT=true
# Comma-separated origins for cross-origin API (required non-empty when NODE_ENV=production)
CORS_ORIGIN=http://localhost:3000
# M2M canon ingestion (/v1/canon) — bind to TENANT_ID unless SERVICE_TOKEN_MAP is set
SERVICE_TOKEN=change-me-service-token
# SERVICE_TOKEN_TENANT_ID=00000000-0000-0000-0000-000000000001
# SERVICE_TOKEN_MAP={"00000000-0000-0000-0000-000000000001":"token-for-tenant-a"}
RUN_MIGRATIONS=true

# SuperTokens Auth
SUPERTOKENS_CORE_URI=http://localhost:3567
SUPERTOKENS_API_KEY=local-development-key
API_DOMAIN=http://localhost:3005
WEBSITE_DOMAIN=http://localhost:3000

EXPORT_WORKER_ENABLED=true
EXPORT_WORKER_POLL_MS=15000
EXPORT_SYSTEM_USER_ID=1
DPR_SCHEDULER_ENABLED=true
DPR_SCHEDULE_HOUR=7
SHIFT_BOUNDARY_SCHEDULER_ENABLED=false

# Optional object storage for export artifacts
MINIO_ENDPOINT=
MINIO_BUCKET=m1-exports
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1

# Cache layer (memory default; set CACHE_DRIVER=redis when REDIS_URL is available)
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379

# Elasticsearch (traceability search). Start with: docker compose up -d elasticsearch
# Leave unset / empty only if you intentionally want PostgreSQL-only fallback.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── Client (@m1/client) ─────────────────────────────────────────────────────
# Vite dev-only auto login (never enable in production)
VITE_DEV_AUTO_LOGIN=false
# Demo / Vercel / Render: show detailed seed login chips on Login (operators + staff).
# Set on the Static Site (or host) env, then redeploy.
# VITE_SHOW_SEED_LOGIN=true
# Render demo also: VITE_API_URL=https://demo.zedral.com (deploy/.env.render.example)
# Low-network perf flags (set to false to disable)
VITE_SWR_IDB_CACHE=true
VITE_SW_API_READ_CACHE=true
VITE_OFFLINE_OUTBOX=true
# Long-running tab / kiosk heap (opt-in; unset = today's behavior)
# VITE_SWR_CACHE_MAX=500
# VITE_IDLE_THROTTLE=true
# VITE_SWR_PERIODIC_PERSIST=true
# VITE_VERBOSE_LOGS=true

# ─── Operator APK (packages/client/.env.operator) ────────────────────────────
# Vite --mode operator loads .env.operator for Capacitor/APK builds.
# Must be reachable from the tablet — NOT localhost.
# QA:  VITE_API_URL=https://qa.zedral.com
# Demo Render: VITE_API_URL=https://demo.zedral.com  (see deploy/.env.render.example)
# LAN: VITE_API_URL=http://10.149.217.114:3005  (port must match PORT above)

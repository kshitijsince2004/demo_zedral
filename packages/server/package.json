{
  "name": "@m1/server",
  "version": "1.0.0",
  "description": "M1 Digital Data Collection Server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && node -e \"const fs=require('fs');const path=require('path');const d='dist/export/layouts';fs.mkdirSync(d,{recursive:true});fs.copyFileSync('src/export/layouts/dpr_layout.v1.json',d+'/dpr_layout.v1.json');const ll=path.join(d,'line_log');fs.mkdirSync(ll,{recursive:true});for(const f of fs.readdirSync('src/export/layouts/line_log').filter(x=>x.endsWith('.json'))){fs.copyFileSync(path.join('src/export/layouts/line_log',f),path.join(ll,f));}\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "migrate": "node-pg-migrate --migrations-dir migrations up",
    "migrate:down": "node-pg-migrate --migrations-dir migrations down",
    "smoke:pilot": "node scripts/pilot-smoke.mjs",
    "clear:data": "node scripts/clear-pilot-data.mjs",
    "seed:pilot": "node scripts/seed-pilot.mjs",
    "seed:users": "node scripts/seed-pilot-users.mjs",
    "reset:pins": "node scripts/reset-pilot-pins.mjs",
    "seed:data": "node scripts/seed-pilot-data.mjs",
    "seed:crm6-ppc": "node scripts/seed-crm6-ppc.mjs",
    "seed:sixhi-ppc": "node scripts/seed-crm6-ppc.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:export": "node scripts/seed-export-demo.mjs",
    "smoke:api": "node scripts/api-smoke.mjs"
  },
  "dependencies": {
    "@m1/shared-validation": "*",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.27.3",
    "multer": "^2.1.1",
    "node-pg-migrate": "^7.3.0",
    "pg": "^8.11.5",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "puppeteer": "^24.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node-cache": "^4.1.3",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "fast-check": "^4.8.0",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}

# Normalize everything to LF in the repo; Git handles checkout on Windows.
* text=auto eol=lf

# Binary types must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.apk binary
*.keystore binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.mp4 binary
*.webm binary
*.sqlite binary
*.db binary
